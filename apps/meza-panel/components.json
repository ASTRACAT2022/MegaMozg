        <section className="grid gap-4 xl:grid-cols-[1.3fr_1fr]">
          <Card id="nodes">
            <CardHeader>
              <CardTitle>Nodes</CardTitle>
              <CardDescription>
                Current inventory with health and capacity indicators.
              </CardDescription>
            </CardHeader>
            <CardContent>
              <Table>
                <TableHeader>
                  <TableRow>
                    <TableHead>Node</TableHead>
                    <TableHead>Status</TableHead>
                    <TableHead>Tags</TableHead>
                    <TableHead className="w-[180px]">CPU</TableHead>
                    <TableHead className="w-[180px]">RAM</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {data.nodes.map((node) => (
                    <TableRow key={node.id}>
                      <TableCell className="align-top">
                        <div className="space-y-1">
                          <div className="font-medium">{node.name}</div>
                          <div className="text-muted-foreground text-xs">
                            {node.region} · last seen {formatTime(node.last_seen_at)}
                          </div>
                        </div>
                      </TableCell>
                      <TableCell className="align-top">
                        <StatusBadge status={node.status} />
                      </TableCell>
                      <TableCell className="align-top">
                        <div className="flex max-w-xs flex-wrap gap-1">
                          {node.tags.map((tag) => (
                            <Badge key={tag} variant="outline">
                              {tag}
                            </Badge>
                          ))}
                        </div>
                      </TableCell>
                      <TableCell className="align-top">
                        <div className="space-y-2">
                          <div className={`text-sm font-medium ${metricTone(node.metrics.cpu_percent)}`}>
                            {node.metrics.cpu_percent}%
                          </div>
                          <Progress value={node.metrics.cpu_percent} />
                        </div>
                      </TableCell>
                      <TableCell className="align-top">
                        <div className="space-y-2">
                          <div className={`text-sm font-medium ${metricTone(node.metrics.ram_percent)}`}>
                            {node.metrics.ram_percent}%
                          </div>
                          <Progress value={node.metrics.ram_percent} />
                        </div>
                      </TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </CardContent>
          </Card>

          <Card id="jobs">
            <CardHeader>
              <CardTitle>Jobs</CardTitle>
              <CardDescription>Review, approval state, and rollout targeting.</CardDescription>
            </CardHeader>
            <CardContent className="space-y-3">
              {data.jobs.map((job) => (
                <div key={job.id} className="rounded-lg border p-4">
                  <div className="flex flex-wrap items-start justify-between gap-3">
                    <div className="space-y-1">
                      <div className="font-medium">{job.type}</div>
                      <p className="text-muted-foreground text-sm">{job.summary}</p>
                    </div>
                    <StatusBadge status={job.status} />
                  </div>

                  <div className="mt-4 grid gap-3 text-sm sm:grid-cols-2">
                    <div>
                      <p className="text-muted-foreground">Target</p>
                      <p className="font-medium">{job.target_selector}</p>
                    </div>
                    <div>
                      <p className="text-muted-foreground">Strategy</p>
                      <p className="font-medium">{job.strategy}</p>
                    </div>
                    <div>
                      <p className="text-muted-foreground">Created by</p>
                      <p className="font-medium">{job.created_by}</p>
                    </div>
                    <div>
                      <p className="text-muted-foreground">Matched nodes</p>
                      <p className="font-medium">{job.matched_nodes.length}</p>
                    </div>
                  </div>

                  <div className="mt-4 flex flex-wrap gap-2">
                    <Badge variant={job.requires_approval ? "outline" : "secondary"}>
                      {job.requires_approval ? "Review required" : "Auto-runnable"}
                    </Badge>
                    {job.matched_nodes.slice(0, 3).map((node) => (
                      <Badge key={node} variant="outline">
                        {node}
                      </Badge>
                    ))}
                  </div>
                </div>
              ))}
            </CardContent>
          </Card>
        </section>

        <section className="grid gap-4 lg:grid-cols-[1.1fr_0.9fr]">
          <Card>
            <CardHeader>
              <CardTitle>Audit trail</CardTitle>
              <CardDescription>Recent control-plane events, sorted from newest to oldest.</CardDescription>
            </CardHeader>
            <CardContent>
              <Table>
                <TableHeader>
                  <TableRow>
                    <TableHead>Action</TableHead>
                    <TableHead>Actor</TableHead>
                    <TableHead>Resource</TableHead>
                    <TableHead>Time</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {data.audit.map((event) => (
                    <TableRow key={event.id}>
                      <TableCell>
                        <div className="space-y-1">
                          <div className="font-medium">{event.action}</div>
                          <div className="text-muted-foreground text-xs">{event.message}</div>
                        </div>
                      </TableCell>
                      <TableCell>{event.actor}</TableCell>
                      <TableCell className="text-muted-foreground">
                        {event.resource_type}:{event.resource_id}
                      </TableCell>
                      <TableCell className="text-muted-foreground">{formatTime(event.created_at)}</TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </CardContent>
          </Card>

          <Card>
            <CardHeader>
              <CardTitle>Operational focus</CardTitle>
              <CardDescription>Quick signals that help decide whether a rollout is safe to continue.</CardDescription>
            </CardHeader>
            <CardContent className="space-y-6">
              <div className="space-y-3">
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-2 text-sm font-medium">
                    <Network className="size-4 text-muted-foreground" />
                    Network throughput
                  </div>
                  <span className="text-sm text-muted-foreground">
                    {data.nodes.reduce((sum, node) => sum + node.metrics.network_kbps, 0)} kbps
                  </span>
                </div>
                <Progress value={Math.min(100, data.nodes.reduce((sum, node) => sum + node.metrics.network_kbps, 0) / 30)} />
              </div>

              <div className="space-y-3">
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-2 text-sm font-medium">
                    <ScrollText className="size-4 text-muted-foreground" />
                    Review queue pressure
                  </div>
                  <span className="text-sm text-muted-foreground">{data.dashboard.awaiting_approvals} waiting</span>
                </div>
                <Progress value={Math.min(100, data.dashboard.awaiting_approvals * 18)} />
              </div>

              <Separator />

              <div className="grid gap-3 sm:grid-cols-2">
                <div className="rounded-lg border p-4">
                  <div className="flex items-center gap-2 text-sm font-medium">
                    <CheckCircle2 className="size-4 text-emerald-600" />
                    Healthy nodes
                  </div>
                  <p className="mt-2 text-2xl font-semibold">{data.dashboard.online_nodes}</p>
                </div>
                <div className="rounded-lg border p-4">
                  <div className="flex items-center gap-2 text-sm font-medium">
                    <Clock3 className="size-4 text-muted-foreground" />
                    AI provider
                  </div>
                  <p className="mt-2 text-2xl font-semibold">{data.samplePlan.provider}</p>
                </div>
              </div>
            </CardContent>
          </Card>
        </section>
      </div>
    </main>
  );
}

